{
  "name": "nexus-desktop",
  "version": "1.1.0",
  "description": "NEXUS - a simple portable desktop file workspace",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nexus.workspace",
    "productName": "NEXUS",
    "asar": true,
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["portable"], "artifactName": "NEXUS-${version}-Windows-Portable.exe" },
    "portable": { "artifactName": "NEXUS-${version}-Windows-Portable.exe" }
  }
}