{
  "name": "nexus-desktop",
  "version": "1.0.0",
  "description": "NEXUS portable Windows workspace with a native terminal",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nexus.workspace",
    "productName": "NEXUS",
    "asar": true,
    "files": ["src/**/*", "node_modules/**/*", "package.json"],
    "npmRebuild": true,
    "win": { "target": ["portable"], "artifactName": "NEXUS-${version}-Windows-Portable.exe" },
    "portable": { "artifactName": "NEXUS-${version}-Windows-Portable.exe" }
  }
}